# Copy to .env.daemon. Secrets are not included in the image.
DAEMON_NAME=VisionSY daemon
DAEMON_IMAGE_TAG=local
DAEMON_BIND_IP=0.0.0.0
DAEMON_PORT=8000
DAEMON_SESSION_COOKIE=visionsy_daemon_session
# Optional link from the media website to the separately deployed dashboard.
DASHBOARD_URL=
# Exact browser origins, comma-separated. No paths or trailing slashes.
# Example: http://192.168.1.10:8090,https://dashboard.example.com
MANAGEMENT_ALLOWED_ORIGINS=

APP_NAME=VisionSY
APP_ENV=production
APP_DEBUG=false
# Generate once: python3 -c 'import base64,secrets;print("base64:"+base64.b64encode(secrets.token_bytes(32)).decode())'
APP_KEY=<APP_KEY>
APP_URL=http://localhost:8000
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
VISIONSY_VERSION=0.2.0
LEGACY_ADMIN_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=visionsy
DB_USERNAME=visionsy
# Generate two independent random passwords and retain them with the data volume.
DB_PASSWORD=<DB_PASSWORD>
DB_ROOT_PASSWORD=<DB_ROOT_PASSWORD>
INTERNAL_API_SECRET=<INTERNAL_API_SECRET>

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700
LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_PROXY_IPS=127.0.0.1

# Host directory; NAS should be mounted on the daemon host first.
DAM_HOST_MANAGED=./data/media
MEDIA_MANAGED_ROOT=/data/visionsy/managed
MEDIA_ALLOWED_ROOTS=/data/visionsy/managed
MEDIA_DIRECT_SERVE=true
MEDIA_GUEST_BROWSE=true
MEDIA_TEACHER_CAN_UPLOAD=true
MEDIA_MAX_UPLOAD_MB=512
MEDIA_WATERMARK_TEXT=VisionSY
MEDIA_SCAN_EXCLUDE="._*,Thumbs.db,.DS_Store,@eaDir"
MEDIA_SCAN_STALE_LOCK_MINUTES=75

PUBLIC_STORAGE_URL=/storage
VISION_RESOURCE_BASE_URL=/media
VISION_AUTH_URL=
VISION_SITE_URL=
VISION_PUBLIC_SITE_URL=
VISION_EXTERNAL_TRANSFER_BASE_URL=
VISION_LAN_TRANSFER_BASE_URL=
INTRANET_PROBE_URL=
CAPTCHA_ENABLED=true
# Configure SMTP in Dashboard → 邮件服务. Log mode does not deliver real email.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=VisionSY
