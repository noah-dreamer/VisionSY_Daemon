# ==================================================================
# VisionSY Docker Compose 环境模板（复制为 .env 后修改）
#   开发建议：cp .env.dev.example .env
#   生产建议：cp .env.prod.example .env
#
# 本文件同时承担两个角色：
#   1) Compose 变量插值（DAM_HOST_*、端口、镜像标签、DB 凭据）；
#   2) 通过 env_file 注入容器，作为 Laravel 的运行时环境变量。
#
# 注意：.env 含数据库凭据，禁止提交到 Git。
# ==================================================================

# ---------- 镜像 / 服务 ----------
APP_IMAGE_TAG=latest
# 宿主机访问 Web 的端口（容器内固定 80）
APP_PORT=8000
# 生产可设置为真实域名（Caddy SERVER_NAME），开发保持 :80 由前置代理/端口映射处理
SERVER_NAME=:80

# ---------- DAM 宿主机挂载路径 ----------
# 容器内路径固定为 /data/visionsy/{managed,sources,derivatives}（见 compose.yaml）。
# 下面填写宿主机路径。Windows 与 Linux 仅此处写法不同：
#   Windows(Docker Desktop)：D:/visionsy/managed   （正斜杠，盘符后无反斜杠）
#   Linux                  ：/srv/visionsy/managed
# 也可用相对路径（相对本 compose 目录），便于开箱即用：
DAM_HOST_MANAGED=./data/managed
DAM_HOST_SOURCES=./data/sources
DAM_HOST_DERIVATIVES=./data/derivatives

# ---------- 数据库（MariaDB） ----------
# DB_* 同时用于创建 MariaDB 容器与 Laravel 连接。
DB_CONNECTION=mysql
# 容器内通过服务名访问数据库
DB_HOST=db
DB_PORT=3306
DB_DATABASE=visionsy
DB_USERNAME=visionsy
DB_PASSWORD=<DB_PASSWORD>
DB_ROOT_PASSWORD=<DB_ROOT_PASSWORD>
# 仅开发：把 DB 暴露到宿主机端口（compose.dev.yaml 使用）
DB_HOST_PORT=3306

# ---------- Laravel 运行时 ----------
APP_NAME=VisionSY
APP_ENV=local
# 首次启动后执行：docker compose exec app php artisan key:generate
# 将输出的 base64:... 填回此处（务必替换占位符）。
APP_KEY=<APP_KEY>
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
# database 队列 retry_after 必须 > worker --timeout(3600)
DB_QUEUE_RETRY_AFTER=3700
# 队列划分：worker 监听 default,scan,derivatives,upload
DB_QUEUE_DEFAULT=default
DB_QUEUE_SCAN=scan
DB_QUEUE_DERIVATIVES=derivatives
DB_QUEUE_UPLOAD=upload

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------- VisionSY 专属 ----------
TRUSTED_PROXY_IPS=127.0.0.1
INTERNAL_API_SECRET=<INTERNAL_API_SECRET>
TRANSFER_TOKEN_TTL_SECONDS=600
TRANSFER_TOKEN_ONE_TIME=true

VISION_RESOURCE_BASE_URL=http://localhost:8000/media
VISION_SITE_URL=http://localhost:8000
VISION_PUBLIC_SITE_URL=http://localhost:8000
VISION_EXTERNAL_TRANSFER_BASE_URL=http://localhost:8000
VISION_LAN_TRANSFER_BASE_URL=http://localhost:8000
VISION_AUTH_URL=http://localhost:8000

# ---------- 内置媒体库（DAM） ----------
# 开发本机直出；生产可改 false 走 307 直连。
MEDIA_DIRECT_SERVE=true
MEDIA_GUEST_BROWSE=true
MEDIA_TEACHER_CAN_UPLOAD=true
MEDIA_MAX_UPLOAD_MB=512
MEDIA_WATERMARK_TEXT=VisionSY
# DAM 三目录（容器内固定路径）
MEDIA_MANAGED_ROOT=/data/visionsy/managed
MEDIA_DERIVATIVES_ROOT=/data/visionsy/derivatives
# 允许的存储源根路径必须是容器内路径（不是宿主机路径）。
MEDIA_ALLOWED_ROOTS=/data/visionsy/managed,/data/visionsy/sources
MEDIA_SCAN_EXCLUDE="._*,Thumbs.db,.DS_Store,@eaDir"
MEDIA_SCAN_BATCH_SIZE=100
MEDIA_SCAN_CHECKSUM_CHANGED=true
# 扫描锁 stale 阈值（分钟）须 > 扫描 Job timeout(60)
MEDIA_SCAN_STALE_LOCK_MINUTES=75
# 元数据/视频工具（镜像已内置 exiftool 与 ffmpeg，留空使用 PATH）
# MEDIA_EXIFTOOL_PATH=/usr/bin/exiftool
# MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg

# ---------- 登录人机验证 / 邮箱验证码 ----------
CAPTCHA_ENABLED=true
CAPTCHA_CHALLENGE_TTL=180
CAPTCHA_PASS_TTL=300
CAPTCHA_MIN_SOLVE_SECONDS=3
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_COOLDOWN=60

# ---------- 仅开发：Vite HMR 端口 ----------
VITE_PORT=5173

# ---------- 内网探测 ----------
# 生产：INTRANET_PROBE_BIND 绑定到宿主机的内网 IP（如 10.0.0.1:8099），
# INTRANET_PROBE_URL 设为该内网地址，前端 fetch 成功即判定为校园网环境。
# 开发：均绑定 127.0.0.1（仅本机可访问）。
INTRANET_PROBE_BIND=127.0.0.1:8099
INTRANET_PROBE_URL=http://127.0.0.1:8099

# ---------- 种子账号（仅开发；生产勿 db:seed，用后台/命令创建账号）----------
# DatabaseSeeder 用 SEED_DEFAULT_PASSWORD 生成开发账号。必须在 deploy/docker/.env 显式提供，
# 不要依赖被 bind-mount 进容器的 web/.env（原生 php artisan serve 的 SQLite 配置）。
SEED_DEFAULT_PASSWORD=<SEED_DEFAULT_PASSWORD>
