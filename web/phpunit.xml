<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            ⚠️ 注意：以下 <env> 默认 force="false"，即"环境变量已存在时不覆盖"。
            在 Docker 容器内运行测试时，app 容器已由 env_file: .env 注入了真实的
            DB_CONNECTION / DB_DATABASE / CACHE_STORE / INTERNAL_API_SECRET / CAPTCHA_* 等，
            因此这里的值会被静默忽略 —— 曾导致测试在开发库上执行 migrate:fresh，把库清空。

            容器内测试必须走 `node deploy/docker/test.mjs`（用 docker compose exec -e
            从外部注入，优先级最高）。此处保留这些值仅用于宿主机原生 php artisan test。

            不要在这里加 force="true"：那会反过来压掉 test.mjs 指定的 visionsy_test 库名。
            web/tests/TestCase.php 中有保险丝兜底。
        -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TRUSTED_PROXY_IPS" value="127.0.0.1"/>
        <env name="INTERNAL_API_SECRET" value="test-only-placeholder"/>
        <env name="TRANSFER_TOKEN_TTL_SECONDS" value="600"/>
        <env name="TRANSFER_TOKEN_ONE_TIME" value="true"/>
        <env name="CAPTCHA_ENABLED" value="false"/>
        <env name="CAPTCHA_MIN_SOLVE_SECONDS" value="0"/>
        <env name="MEDIA_DIRECT_SERVE" value="true"/>
        <env name="MEDIA_GUEST_BROWSE" value="true"/>
        <env name="MEDIA_TEACHER_CAN_UPLOAD" value="true"/>
        <env name="EMAIL_CODE_RESEND_COOLDOWN" value="60"/>
    </php>
</phpunit>
