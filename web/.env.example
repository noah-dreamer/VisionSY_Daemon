# =============================================================
# VisionSY 官网应用 环境配置示例
# 复制为 .env 后按需修改。生产环境真实密钥不入库：
#   - 官网相关密钥          ：`<SECRET_MANAGER>`
#   - ResourceSpace 客户端凭据：`<SECRET_MANAGER>`
#   - ResourceSpace 数据库   ：`<SECRET_MANAGER>`
#   - DNS 服务商 DNS API        ：`<SECRET_MANAGER>`
#   - Cloudflare SaaS Zone  ：`<SECRET_MANAGER>`
# =============================================================

APP_NAME=VisionSY
APP_ENV=local
APP_KEY=<APP_KEY>
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=visionsy
DB_USERNAME=visionsy
DB_PASSWORD=<DB_PASSWORD>

# —— 本地开发推荐改用 SQLite（touch database/database.sqlite 即可）——
# DB_CONNECTION=sqlite
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# 本地默认 log 驱动，验证链接从 storage/logs/laravel.log 复制。
# 若想在浏览器里收邮件，可 `brew install mailpit && mailpit` 后改为：
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------- VisionSY 专属配置 ----------------

# 可信代理 IP（仅来自这些来源的 X-Real-IP / CF-Connecting-IP / XFF 才被信任）
# 生产环境为 反向代理网关 容器内网 IP：10.0.0.30
TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.30

# 内部 API 共享密钥（反向代理网关 / Nginx 调用 transfer-token 接口时使用）
# 生产真实值：`<SECRET_MANAGER>`
INTERNAL_API_SECRET=<INTERNAL_API_SECRET>

# 大文件 307 直连令牌
TRANSFER_TOKEN_TTL_SECONDS=600
TRANSFER_TOKEN_ONE_TIME=true

# 示例业务域名（部署时按实际环境修改）
VISION_RESOURCE_BASE_URL=https://media.example.com
VISION_SITE_URL=https://www.example.com
VISION_PUBLIC_SITE_URL=https://example.com
VISION_EXTERNAL_TRANSFER_BASE_URL=https://files.example.com:<GATEWAY_PORT>
VISION_LAN_TRANSFER_BASE_URL=https://files-internal.example.com:<GATEWAY_PORT>

# ---------------- 内置媒体库（DAM） ----------------
# direct_serve=true：本机直接返回文件（本地开发 / 单机部署）
# direct_serve=false：大文件下载按 README 走 307 直连（TransferToken）
MEDIA_DIRECT_SERVE=true
MEDIA_GUEST_BROWSE=true
MEDIA_TEACHER_CAN_UPLOAD=true
MEDIA_MAX_UPLOAD_MB=512
# 水印文本默认 ASCII；配置 TTF 字体路径后可用中文文本
MEDIA_WATERMARK_TEXT=VisionSY
# MEDIA_WATERMARK_FONT=/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc
# 元数据/视频工具（对齐 ResourceSpace 的 exiftool/ffmpeg 依赖；留空使用 PATH，
# 未安装时自动回退：元数据 → PHP exif + getID3；视频封面 → 跳过）
# MEDIA_EXIFTOOL_PATH=/usr/bin/exiftool
# MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
# RAW 转换器（exiftool_preview 提取内嵌 JPEG；可改为 dcraw、darktable-cli 等外部工具的命令和参数）
# MEDIA_RAW_CONVERTER=exiftool_preview
# RAW 内嵌预览最小字节数（低于此值视为无效）
# MEDIA_RAW_MIN_PREVIEW_BYTES=1024
# 水印图最大边长（默认 3200px）
# MEDIA_WATERMARK_MAX_EDGE=3200

# ---------------- 存储源（DAM 多存储源支持） ----------------
# 逗号分隔的允许根路径列表，存储源必须位于这些路径之内
MEDIA_ALLOWED_ROOTS=/mnt,/media,/var/local
# 扫描时排除的文件/目录模式（逗号分隔 glob 模式）
MEDIA_SCAN_EXCLUDE="._*,Thumbs.db,.DS_Store,@eaDir"
# 每批处理的文件数量
MEDIA_SCAN_BATCH_SIZE=100
# 仅在文件大小或修改时间变化时才计算 SHA-256 校验值
MEDIA_SCAN_CHECKSUM_CHANGED=true

# -------- 登录人机验证（PlayCaptcha 抓娃娃机，github.com/mortspace/playcaptcha） --------
CAPTCHA_ENABLED=true
CAPTCHA_CHALLENGE_TTL=180
CAPTCHA_PASS_TTL=300
CAPTCHA_MIN_SOLVE_SECONDS=3

# ---------------- 邮箱验证码 ----------------
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_COOLDOWN=60

# 种子数据默认密码（仅本地开发，生产不要执行 seed）
SEED_DEFAULT_PASSWORD=<LOCAL_DEV_PASSWORD>
# 种子创建的 ResourceSpace OAuth client secret（仅本地开发）
SEED_RS_CLIENT_SECRET=<OAUTH_CLIENT_SECRET>
