{
    "version": "2.0.0",
    // VisionSY 任务（Docker Compose + FrankenPHP）
    // Ctrl/Cmd+Shift+P → Tasks: Run Task
    //
    //   首次：初始化开发环境    日常：一键部署    生产：一键发布
    //
    //   运行测试：只用「VisionSY: 测试」（走 deploy/docker/test.mjs，隔离测试库）。
    //   绝不要执行 `docker compose exec app php artisan test`——它会清空开发数据库。
    //
    // 种子账号（重建开发数据库后可用，密码统一 visionsy-dev）：
    //   admin@example.com 管理员 · media@example.com 宣传部 · teacher@example.com 官微
    //   student@student.example.com 普通用户 · pending@student.example.com 待激活

    "tasks": [
        {
            "label": "VisionSY: 初始化开发环境",
            "detail": "首次使用：生成 .env → 构建镜像 → 启动 → APP_KEY → 迁移",
            "type": "process",
            "command": "node",
            "args": ["init.mjs"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: 一键部署 (开发)",
            "detail": "日常使用：构建镜像 → 启动并等健康 → migrate --force（非破坏性）",
            "type": "process",
            "command": "node",
            "args": ["deploy.mjs", "dev"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: 一键发布 (生产)",
            "detail": "生产发布：构建 → 启动 → migrate --force。发布前请先备份数据库",
            "type": "process",
            "command": "node",
            "args": ["deploy.mjs", "prod"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: 停止",
            "detail": "docker compose down（停止容器，保留数据卷）",
            "type": "process",
            "command": "docker",
            "args": ["compose", "-f", "compose.yaml", "-f", "compose.dev.yaml", "--env-file", ".env", "down"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: 迁移",
            "detail": "migrate --force（非破坏性）。更新代码后登录失效时用此恢复，勿用 migrate:fresh",
            "type": "process",
            "command": "docker",
            "args": ["compose", "-f", "compose.yaml", "-f", "compose.dev.yaml", "--env-file", ".env", "exec", "-T", "app", "php", "artisan", "migrate", "--force"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: Shell",
            "detail": "进入 app 容器（可执行 artisan 命令、查看文件等）",
            "type": "process",
            "command": "docker",
            "args": ["compose", "-f", "compose.yaml", "-f", "compose.dev.yaml", "--env-file", ".env", "exec", "app", "sh"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: 日志",
            "detail": "docker compose logs -f app（FrankenPHP / Laravel 实时日志）",
            "type": "process",
            "command": "docker",
            "args": ["compose", "-f", "compose.yaml", "-f", "compose.dev.yaml", "--env-file", ".env", "logs", "-f", "app"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: 测试",
            "detail": "在隔离测试库 visionsy_test 上运行全部测试。禁止裸跑 php artisan test（会清空开发库）",
            "type": "process",
            "command": "node",
            "args": ["test.mjs"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: 创建/修复管理员账号",
            "detail": "幂等修复管理员登录（visionsy:ensure-admin）。非破坏性，生产亦可用",
            "type": "process",
            "command": "docker",
            "args": [
                "compose", "-f", "compose.yaml", "-f", "compose.dev.yaml", "--env-file", ".env",
                "exec", "-T", "app",
                "php", "artisan", "visionsy:ensure-admin", "${input:adminEmail}"
            ],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: 用户数量自检",
            "detail": "登录失效时先跑这个：输出 users 表行数。返回 0 说明库被清空了",
            "type": "process",
            "command": "docker",
            "args": [
                "compose", "-f", "compose.yaml", "-f", "compose.dev.yaml", "--env-file", ".env",
                "exec", "-T", "app",
                "php", "artisan", "tinker", "--execute=echo 'users=' . App\\Models\\User::count() . PHP_EOL;"
            ],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        },
        {
            "label": "VisionSY: ⚠ 重建开发数据库",
            "detail": "⚠ 危险：migrate:fresh --seed 会清空重建。仅限可丢弃开发库，切勿用于生产",
            "type": "process",
            "command": "docker",
            "args": ["compose", "-f", "compose.yaml", "-f", "compose.dev.yaml", "--env-file", ".env", "exec", "-T", "app", "php", "artisan", "migrate:fresh", "--seed", "--force"],
            "options": { "cwd": "${workspaceFolder}/deploy/docker" },
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "visionsy" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "adminEmail",
            "type": "promptString",
            "description": "管理员邮箱",
            "default": "admin@example.com"
        }
    ]
}
